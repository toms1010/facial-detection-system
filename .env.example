# Copy to .env and fill in. Never commit .env.
# Every value can also be supplied as a plain environment variable.

# --- MySQL -----------------------------------------------------------------
# The production target. If these are unset the application reads them from the
# environment anyway; there is no default password anywhere in the codebase.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=linux_ai_vision
MYSQL_USER=visionai
MYSQL_PASSWORD=

# --- Optional: local store instead of MySQL --------------------------------
# Set a path to use SQLite for development. Unset means MySQL.
# VISIONAI_SQLITE_PATH=/tmp/visionai-dev.db

# --- Application paths -----------------------------------------------------
# VISIONAI_CONFIG=/home/you/.config/linux-ai-vision/settings.json
# VISIONAI_LOG_DIR=/home/you/.local/share/linux-ai-vision/logs
# VISIONAI_NATIVE_LIB=/path/to/libvisionai_hw.so
# VISIONAI_MODEL_DIR=/path/to/models/face
